VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# Resend (correos). RESEND_API_KEY NO lleva prefijo VITE_: solo la lee el proxy de vite.config.js.
RESEND_API_KEY=re_TU_API_KEY
# Opcional: remitente y destino de prueba (el modo de pruebas solo envía a la casilla dueña de la cuenta).
VITE_RESEND_FROM=AquaData <onboarding@resend.dev>
VITE_RESEND_DESTINO_PRUEBA=aquadata26@gmail.com

# Google Calendar. Sin prefijo VITE_: solo los lee el proxy de vite.config.js.
# El Access Token se genera en el OAuth Playground con el scope calendar.events y dura 1 hora.
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCESS_TOKEN=ya29.TU_TOKEN_DE_ACCESO_AQUI
